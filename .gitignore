.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Data and models are regenerated by `make all`. The download manifest is kept
# so the exact raw file (date + SHA-256) is on record.
data/raw/*
!data/raw/.gitkeep
!data/raw/download_manifest.json
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
*.part
